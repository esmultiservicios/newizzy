# Copiar a la ruta privada del entorno. Completar los valores base antes del diagnóstico.
# Requeridos para iniciar
SERVER=
USER=
PASS=
DB_MAIN=
SECRET_KEY=
SECRET_IV=
# Cambiar METHOD o las claves existentes puede impedir leer datos cifrados.
METHOD=AES-256-CBC

# DB_PRUEBA se usa en la comparación del endpoint de sesión. SERVER_MAIN hereda SERVER.
# SERVER_MAIN=
# DB_PRUEBA=
# DB_PREFIX=
DB_MAX_LENGTH=10

# cPanel UAPI. Requeridas solo para alta/provisión. DOMINIO se usa al operar subdominios.
# CPANEL_HOST=
# CPANEL_USERNAME=
# CPANEL_TOKEN=
# CPANEL_DOMINIO=
CPANEL_PORT=2083
API_TIMEOUT=60

# WHM. Solo para operar cuentas de alojamiento.
# WHM_HOST=
# WHM_USERNAME=
# WHM_TOKEN=
WHM_PORT=2087
WHM_TIMEOUT=30

# Cocina. Copiar la llave vigente del ambiente si ya está en uso.
# IZZY_COCINA_TOKEN_CIPHER_KEY=
# API externas. Puede conservar el archivo privado .izzy_external_api_aes.key.
# IZZY_EXTERNAL_API_ENCRYPTION_KEY=
IZZY_DOCUMENT_AUTO_EMAIL=true
# WEB_SCRAPING_DOLARES=
# IZZY_APP_VERSION=

# En el comando del cron, indicar APP_URL con el dominio correcto del ambiente.
# IZZY_ENV_FILE es una variable externa al archivo, para seleccionar una ruta privada explícita.

