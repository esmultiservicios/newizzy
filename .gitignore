# ============================================================
# IZZY - Archivos que NO deben entrar al repositorio
# ============================================================

# Entorno y credenciales
.env
.env.*
credentials/
secrets/

# Configuración específica del servidor / cPanel
.user.ini
php.ini
.well-known/

# Logs y archivos runtime
error_log
**/error_log
*.log
logs/
cache/
tmp/
temp/
sessions/
*.pid

# Backups y archivos temporales de editores/sistema
backup/
backups/
*.bak
*.backup
*.tmp
*.swp
*~
.DS_Store
Thumbs.db

# Archivos de gastos subidos por usuarios
vistas/plantilla/gastos/

# Logos dinámicos generados/subidos
vistas/plantilla/img/enterprise/logo_*.png
vistas/plantilla/img/enterprise/logo_*.jpg
vistas/plantilla/img/enterprise/logo_*.jpeg

# Logos dinámicos
vistas/plantilla/img/logos/logo_*.png
vistas/plantilla/img/logos/logo_*.jpg
vistas/plantilla/img/logos/logo_*.jpeg

# Productos dinámicos
vistas/plantilla/img/products/prod_*.png
vistas/plantilla/img/products/prod_*.jpg
vistas/plantilla/img/products/prod_*.jpeg
vistas/plantilla/img/products/prod_*.webp

# IMPORTANTE:
# No se ignoran *.lock de forma global porque archivos como composer.lock
# pueden ser necesarios y deben permanecer versionados cuando existan.
