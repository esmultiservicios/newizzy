# API IZZY v1: conservar el Bearer Authorization bajo Apache/FastCGI.
# Aplica a auth/ y a los recursos nuevos de esta versión.
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^ - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>

<IfModule mod_setenvif.c>
    SetEnvIfNoCase Authorization "^(.+)$" HTTP_AUTHORIZATION=$1
</IfModule>
